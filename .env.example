# --- Supabase -----------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
SUPABASE_URL=

# Service-role / secret key. SERVER ONLY.
# This key bypasses Row Level Security. It must never be prefixed with
# NEXT_PUBLIC_ and must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse protection ---------------------------------------------------------
# Random secret used to hash submitter IP addresses before they are stored, so
# the rate-limit table never holds a raw IP. Generate with:
#   openssl rand -hex 32
IP_HASH_SALT=
